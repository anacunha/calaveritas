# AWS Configuration for Amazon Bedrock
AWS_REGION=us-east-1

# Authentication Method 1: OIDC with IAM Role (RECOMMENDED for Vercel)
# Use this for secure, credential-less authentication in production
# The IAM role must have permissions to invoke Bedrock models
# AWS_ROLE_ARN=arn:aws:iam::123456789012:role/VercelCalaveritasBedrockRole

# Authentication Method 2: Static Credentials (for local development)
# Required if AWS_ROLE_ARN is not set. Obtain these from your AWS IAM console.
# AWS_ACCESS_KEY_ID=your_access_key_here
# AWS_SECRET_ACCESS_KEY=your_secret_key_here

# AWS Session Token (Optional)
# Only required if using temporary credentials (e.g., from AWS STS or assumed roles)
# AWS_SESSION_TOKEN=your_session_token_here

# Claude Model Configuration
# Specifies which Claude model to use in Amazon Bedrock
# Available models:
# - us.anthropic.claude-3-sonnet-20240229-v1:0 (balanced performance and cost)
# - us.anthropic.claude-3-opus-20240229-v1:0 (highest capability)
# - us.anthropic.claude-3-haiku-20240307-v1:0 (fastest and most cost-effective)
CLAUDE_MODEL_ID=us.anthropic.claude-3-sonnet-20240229-v1:0

# AI Test Mode
# Set to "true" to use mock responses instead of calling the real AI service
# Useful for development and testing without consuming API credits
# Set to "false" for production
AI_TEST_MODE=false

# Timeout Configuration (in seconds)
# AI_VISION_TIMEOUT: Maximum time allowed for image analysis
# AI_GENERATION_TIMEOUT: Maximum time allowed for complete calaverita generation
AI_VISION_TIMEOUT=10
AI_GENERATION_TIMEOUT=30
